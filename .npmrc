# Refuse to install on a Node this project cannot run on, rather than letting the install
# succeed and the app fail later with something cryptic.
#
# `node:sqlite` arrived in Node 22 and is what makes a fresh clone work with no native build
# and no database to provision. On Node 20 everything installs cleanly and then dies at the
# first import with ERR_UNKNOWN_BUILTIN_MODULE, which reads like a broken project rather than
# a wrong runtime. `engines` alone is advisory; this is what makes npm act on it.
engine-strict=true
