# Nothing here is needed to run the app locally — the defaults work.

# Where the database lives. A path for a file, or :memory: for a throwaway one.
DATABASE_URL=.data/hamscaler.db

# Ports. Chosen away from the usual 3000/4000 so the app does not collide with whatever else
# is running on your machine.
WEB_PORT=3410
API_PORT=4410

# Set in production. It is what makes the session cookie Secure.
NODE_ENV=production

# Managed hosts inject PORT and expect the process to bind exactly it. Nothing to set by hand:
# the API reads PORT first and falls back to API_PORT above.
# PORT=10000
