{
  "name": "turbohamscaler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:migrate": "node --disable-warning=ExperimentalWarning --import tsx packages/api/src/db/migrate.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning --import tsx packages/api/src/db/seed.ts",
    "db:reset": "node --disable-warning=ExperimentalWarning --import tsx packages/api/src/db/reset.ts",
    "test:api": "node --disable-warning=ExperimentalWarning --import tsx --test \"packages/api/src/**/*.test.ts\"",
    "test:unit": "node --disable-warning=ExperimentalWarning --import tsx --test \"packages/web/src/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "test": "npm run test:api && npm run test:unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:e2e:dist": "npm run prerender && node scripts/e2e-dist.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "ci": "node scripts/ci-local.mjs",
    "check:tenancy": "node scripts/check-tenancy.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "prerender": "npm run build --workspace=@hamscaler/web && node scripts/prerender.mjs",
    "test:api:worker": "node scripts/test-worker.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.58.1",
    "axe-core": "^4.13.0",
    "tsx": "^4.20.7",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@10.9.4"
}
